# Database
MONGODB_URI=mongodb://mongodb:27017/automated-deployment

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO Object Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server IP Configuration
# Change this to your server's IP address for remote access
SERVER_IP=localhost

# Services
UPLOAD_SERVICE_PORT=3002
BUILD_SERVICE_PORT=3001
FRONTEND_PORT=5173

# Frontend API URLs (for building frontend)
# These will be constructed from SERVER_IP if not explicitly set
VITE_SERVER_IP=${SERVER_IP}
VITE_API_URL=http://${SERVER_IP}:${UPLOAD_SERVICE_PORT}
VITE_BUILD_SERVICE_URL=http://${SERVER_IP}:${BUILD_SERVICE_PORT}
VITE_FRONTEND_URL=http://${SERVER_IP}:${FRONTEND_PORT}
VITE_FRONTEND_PORT=${FRONTEND_PORT}
VITE_UPLOAD_SERVICE_PORT=${UPLOAD_SERVICE_PORT}
VITE_BUILD_SERVICE_PORT=${BUILD_SERVICE_PORT}
FRONTEND_URL=http://${SERVER_IP}:${FRONTEND_PORT}

# GitHub OAuth Callback (uses SERVER_IP)
GITHUB_CALLBACK_URL=http://${SERVER_IP}:${FRONTEND_PORT}/auth/github/callback
VITE_GITHUB_CALLBACK_URL=http://${SERVER_IP}:${FRONTEND_PORT}/auth/github/callback
