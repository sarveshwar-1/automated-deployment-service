# Database
MONGODB_URI=mongodb://mongodb:27017/automated-deployment

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO Object Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server IP Configuration
SERVER_IP=172.17.9.74

# Services
UPLOAD_SERVICE_PORT=3002
BUILD_SERVICE_PORT=3001
FRONTEND_PORT=5173

# Frontend API URLs (for building frontend)
VITE_API_URL=http://172.17.9.74:3002
VITE_BUILD_SERVICE_URL=http://172.17.9.74:3001
FRONTEND_URL=http://172.17.9.74:5173
