/* Dashboard Page */
.dashboard-container {
  min-height: 100vh;
  padding: 32px 24px;
  max-width: 1400px;
  margin: 0 auto;
}

.dashboard-header {
  margin-bottom: 32px;
}

.back-btn {
  padding: 8px 16px;
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
  border: 1px solid rgba(59, 130, 246, 0.3);
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.2s ease;
  margin-bottom: 24px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.back-btn::before {
  content: '←';
  font-size: 16px;
}

.back-btn:hover {
  background: rgba(59, 130, 246, 0.2);
  border-color: rgba(59, 130, 246, 0.5);
  transform: translateX(-4px);
}

.project-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.project-title h1 {
  font-size: 32px;
  font-weight: 700;
  color: #f8fafc;
  margin: 0;
  letter-spacing: -0.02em;
}

.project-status {
  display: flex;
  gap: 12px;
}

.status-badge {
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.status-active {
  background: rgba(34, 197, 94, 0.1);
  color: #86efac;
  border: 1px solid rgba(34, 197, 94, 0.3);
}

/* Tabs */
.dashboard-tabs {
  display: flex;
  gap: 8px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
  margin-bottom: 32px;
}

.tab-btn {
  padding: 12px 24px;
  background: transparent;
  color: #94a3b8;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.2s ease;
  position: relative;
}

.tab-btn:hover {
  color: #cbd5e1;
  background: rgba(59, 130, 246, 0.05);
}

.tab-btn.active {
  color: #3b82f6;
  border-bottom-color: #3b82f6;
}

/* Dashboard Content */
.dashboard-content {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

.stat-card {
  background: rgba(30, 41, 59, 0.6);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(148, 163, 184, 0.1);
  border-radius: 12px;
  padding: 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  transition: all 0.2s ease;
}

.stat-card:hover {
  border-color: rgba(59, 130, 246, 0.3);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(59, 130, 246, 0.15);
}

.stat-icon {
  font-size: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%);
  border-radius: 12px;
  border: 1px solid rgba(59, 130, 246, 0.2);
  position: relative;
}

.stat-icon::before {
  content: '';
  width: 24px;
  height: 24px;
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  border-radius: 6px;
  opacity: 0.6;
}

.stat-content {
  flex: 1;
}

.stat-label {
  font-size: 12px;
  color: #94a3b8;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}

.stat-value {
  font-size: 20px;
  font-weight: 700;
  color: #f8fafc;
}

/* Status-specific styles */
.stat-value.status-building {
  color: #60a5fa;
  animation: pulse 2s ease-in-out infinite;
}

.stat-value.status-success {
  color: #86efac;
}

.stat-value.status-failed {
  color: #fca5a5;
}

.stat-value.status-pending {
  color: #d1d5db;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

.stat-error {
  font-size: 13px;
  color: #fca5a5;
  font-family: 'Courier New', monospace;
  background: rgba(239, 68, 68, 0.1);
  padding: 8px;
  border-radius: 4px;
  border: 1px solid rgba(239, 68, 68, 0.2);
  max-width: 100%;
  overflow-wrap: break-word;
}

.error-card {
  border-color: rgba(239, 68, 68, 0.3);
  background: rgba(239, 68, 68, 0.05);
}

.error-card .stat-icon {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(220, 38, 38, 0.15) 100%);
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.error-card .stat-icon::before {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
}

.stat-value-mono {
  font-size: 14px;
  font-weight: 600;
  color: #cbd5e1;
  font-family: 'Courier New', monospace;
}

.stat-link {
  font-size: 14px;
  font-weight: 600;
  color: #3b82f6;
  text-decoration: none;
  transition: color 0.2s ease;
}

.stat-link:hover {
  color: #60a5fa;
}

/* Project Details Section */
.project-details-section,
.actions-section,
.deployments-section,
.settings-section {
  background: rgba(30, 41, 59, 0.6);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(148, 163, 184, 0.1);
  border-radius: 12px;
  padding: 32px;
  margin-bottom: 24px;
}

.project-details-section h2,
.actions-section h2,
.deployments-section h2,
.settings-section h2 {
  font-size: 20px;
  font-weight: 700;
  color: #f8fafc;
  margin-top: 0;
  margin-bottom: 24px;
}

.details-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  background: rgba(15, 23, 42, 0.5);
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.1);
  gap: 16px;
  flex-wrap: wrap;
}

.detail-label {
  font-size: 13px;
  color: #94a3b8;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  min-width: 140px;
}

.detail-value {
  color: #cbd5e1;
  font-size: 14px;
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.detail-value-mono {
  font-family: 'Courier New', monospace;
  font-size: 13px;
  background: rgba(15, 23, 42, 0.8);
  padding: 4px 12px;
  border-radius: 4px;
  border: 1px solid rgba(148, 163, 184, 0.1);
}

.detail-link {
  color: #3b82f6;
  text-decoration: none;
  transition: color 0.2s ease;
}

.detail-link:hover {
  color: #60a5fa;
}

/* Actions */
.action-buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.action-btn {
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  position: relative;
}

.action-btn::before {
  content: '';
  width: 16px;
  height: 16px;
  border-radius: 3px;
  background: currentColor;
  opacity: 0.5;
}

.action-btn-primary {
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.4);
}

.action-btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(59, 130, 246, 0.5);
}

.action-btn-secondary {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
  border: 1px solid rgba(59, 130, 246, 0.3);
}

.action-btn-secondary:hover {
  background: rgba(59, 130, 246, 0.2);
  border-color: rgba(59, 130, 246, 0.5);
  transform: translateY(-2px);
}

.action-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  background: rgba(100, 116, 139, 0.2);
  color: #64748b;
  border-color: rgba(100, 116, 139, 0.2);
}

.action-btn:disabled::before {
  display: none;
}

.action-btn:disabled:hover {
  transform: none;
  box-shadow: none;
}

/* Deployments */
.deployments-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.deployment-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  background: rgba(15, 23, 42, 0.5);
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.1);
  transition: all 0.2s ease;
}

.deployment-item:hover {
  border-color: rgba(59, 130, 246, 0.3);
  background: rgba(15, 23, 42, 0.7);
}

.deployment-status {
  font-size: 20px;
}

.deployment-success {
  color: #86efac;
}

.deployment-content {
  flex: 1;
}

.deployment-commit {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.deployment-commit strong {
  color: #f8fafc;
  font-size: 14px;
}

.deployment-commit code {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-family: 'Courier New', monospace;
}

.deployment-meta {
  font-size: 13px;
  color: #94a3b8;
}

.deployment-link {
  color: #3b82f6;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.2s ease;
}

.deployment-link:hover {
  color: #60a5fa;
  transform: translateX(4px);
}

.empty-state {
  text-align: center;
  padding: 48px 24px;
  color: #94a3b8;
}

.empty-state p {
  margin: 0 0 8px 0;
  font-size: 14px;
}

.empty-state small {
  font-size: 12px;
  color: #64748b;
}

/* Build Logs */
.logs-container {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 24px;
  min-height: 500px;
}

.logs-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-height: 600px;
  overflow-y: auto;
  padding-right: 8px;
}

.log-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  background: rgba(15, 23, 42, 0.5);
  border-radius: 8px;
  border: 1px solid rgba(148, 163, 184, 0.1);
  transition: all 0.2s ease;
  cursor: pointer;
}

.log-item:hover {
  border-color: rgba(59, 130, 246, 0.3);
  background: rgba(15, 23, 42, 0.7);
  transform: translateX(4px);
}

.log-item.active {
  border-color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
}

.log-status {
  font-size: 16px;
  flex-shrink: 0;
}

.log-success {
  color: #86efac;
}

.log-failed {
  color: #fca5a5;
}

.log-content {
  flex: 1;
  min-width: 0;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  gap: 8px;
}

.log-header strong {
  color: #f8fafc;
  font-size: 14px;
}

.log-size {
  font-size: 12px;
  color: #64748b;
  font-family: 'Courier New', monospace;
}

.log-meta {
  font-size: 12px;
  color: #94a3b8;
}

.log-actions {
  flex-shrink: 0;
}

.view-icon {
  color: #3b82f6;
  font-size: 18px;
  font-weight: bold;
}

.log-viewer {
  background: rgba(15, 23, 42, 0.8);
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 600px;
}

.log-viewer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
  background: rgba(30, 41, 59, 0.6);
}

.log-viewer-header h3 {
  font-size: 16px;
  font-weight: 600;
  color: #f8fafc;
  margin: 0;
}

.close-log-btn {
  background: transparent;
  border: none;
  color: #94a3b8;
  font-size: 20px;
  cursor: pointer;
  padding: 4px 8px;
  transition: all 0.2s ease;
  line-height: 1;
}

.close-log-btn:hover {
  color: #f8fafc;
  background: rgba(148, 163, 184, 0.1);
  border-radius: 4px;
}

.log-viewer-content {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.log-text {
  margin: 0;
  padding: 0;
  font-family: 'Courier New', 'Monaco', monospace;
  font-size: 13px;
  line-height: 1.6;
  color: #cbd5e1;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.log-text::selection {
  background: rgba(59, 130, 246, 0.3);
}

.empty-state small {
  font-size: 12px;
  color: #64748b;
}

/* Settings */
.settings-group {
  margin-bottom: 32px;
}

.settings-group:last-child {
  margin-bottom: 0;
}

.settings-group h3 {
  font-size: 16px;
  font-weight: 600;
  color: #f8fafc;
  margin-bottom: 16px;
}

.setting-item {
  margin-bottom: 24px;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-item label {
  display: block;
  font-size: 13px;
  color: #cbd5e1;
  font-weight: 600;
  margin-bottom: 8px;
}

.setting-input {
  width: 100%;
  padding: 12px 16px;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 8px;
  color: #cbd5e1;
  font-size: 14px;
  font-family: 'Courier New', monospace;
  transition: all 0.2s ease;
}

.setting-input:focus {
  outline: none;
  border-color: rgba(59, 130, 246, 0.5);
  background: rgba(15, 23, 42, 0.7);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.setting-item small {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: #64748b;
}

/* Danger Zone */
.danger-zone {
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 8px;
  padding: 24px;
  background: rgba(239, 68, 68, 0.05);
}

.danger-zone h3 {
  color: #fca5a5;
}

.danger-setting {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.danger-setting strong {
  color: #f8fafc;
  font-size: 14px;
  display: block;
  margin-bottom: 8px;
}

.danger-setting p {
  color: #94a3b8;
  font-size: 13px;
  margin: 0;
}

.danger-btn {
  padding: 10px 20px;
  background: rgba(239, 68, 68, 0.1);
  color: #fca5a5;
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.2s ease;
}

.danger-btn:hover {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.5);
  transform: translateY(-1px);
}

/* Responsive */
@media (max-width: 768px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .detail-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .detail-value {
    text-align: left;
  }

  .dashboard-tabs {
    overflow-x: auto;
  }

  .action-buttons {
    flex-direction: column;
  }

  .action-btn {
    width: 100%;
    justify-content: center;
  }

  .danger-setting {
    flex-direction: column;
    align-items: flex-start;
  }

  .danger-btn {
    width: 100%;
  }

  /* Logs responsive */
  .logs-container {
    grid-template-columns: 1fr;
  }

  .logs-list {
    max-height: 400px;
  }

  .log-viewer {
    max-height: 500px;
  }
}
